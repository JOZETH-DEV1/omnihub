rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función para verificar si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función para verificar si el usuario actual es el dueño del documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Reglas para Usuarios
    match /users/{userId} {
      allow read: if true; // Cualquier persona puede ver el perfil
      
      // Solo el dueño puede editar su perfil, pero NO puede modificarse el campo "isVerified" 
      // (eso lo harás tú manualmente desde la consola de Firebase o un panel de admin)
      allow update: if isOwner(userId) 
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'isAdmin']));
      allow create: if isOwner(userId);
      
      // Subcolección de seguidores
      match /followers/{followerId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == followerId;
      }
      
      // Subcolección de seguidos
      match /following/{followingId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // Reglas para Publicaciones
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      
      // Subcolección de likes
      match /likes/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }
      
      // Subcolección de comentarios
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }
    }
  }
}
